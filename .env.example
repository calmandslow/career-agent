LLM_PROVIDER=mock
# Qwen (Alibaba Cloud Model Studio)
# LLM_PROVIDER=qwen
# DASHSCOPE_API_KEY=your_api_key_here
# V1.6.2 model routing: low-cost checks use Flash; core generation uses Plus.
# QWEN_FAST_MODEL=qwen3.8-flash
# QWEN_CORE_MODEL=qwen3.7-plus
# If Flash quota is unavailable, temporarily use Plus for both tiers:
# QWEN_FAST_MODEL=qwen3.7-plus
# Backward compatibility: QWEN_MODEL overrides both tiers when the tier-specific
# variables above are not set.
# QWEN_MODEL=qwen3.7-plus
# Optional: override this if the API console gives you a workspace-specific URL.
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# V1.6 reliability and progress. The SDK's hidden retries are disabled; the
# Harness owns retry classification, backoff, progress, and call logging.
# LLM_TIMEOUT_SECONDS=180
# LLM_MAX_RETRIES=2
# LLM_RETRY_BASE_SECONDS=2
# LLM_RETRY_MAX_SECONDS=8
# PROGRESS_HEARTBEAT_SECONDS=15

# Optional custom price table. Defaults to config/model_pricing.json.
# MODEL_PRICING_PATH=C:\path\to\model_pricing.json

# Optional OpenAI provider
# OPENAI_API_KEY=your_api_key_here
# OPENAI_MODEL=gpt-6-astra
